@@ -348,6 +349,16 @@ static int __init qtee_shmbridge_init(void)
 		return 0;
 	}
 
+	/*
+	 * This issues an SMC to the real TrustZone shmbridge TA. Under QEMU
+	 * (no "qcom,kona" compatible root, e.g. its "linux,dummy-virt" virt
+	 * board) there is no EL3 firmware to answer it, and the smc
+	 * instruction itself UNDEFINED-traps instead of returning an error
+	 * — skip it there.
+	 */
+	if (!of_machine_is_compatible("qcom,kona"))
+		return 0;
+
