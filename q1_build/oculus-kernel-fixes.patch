diff --git a/drivers/tty/serial/amba-pl011.c b/drivers/tty/serial/amba-pl011.c
index 2a2975c3..5516af17 100644
--- a/drivers/tty/serial/amba-pl011.c
+++ b/drivers/tty/serial/amba-pl011.c
@@ -1420,6 +1420,17 @@ static unsigned int pl011_get_mctrl(struct uart_port *port)
 	TIOCMBIT(UART01x_FR_CTS, TIOCM_CTS);
 	TIOCMBIT(UART011_FR_RI, TIOCM_RNG);
 #undef TIOCMBIT
+
+	/*
+	 * Some platforms (e.g. QEMU's "virt" board PL011 model) never wire
+	 * up real modem-control lines, so DCD is never reported asserted.
+	 * That makes tty_port_block_til_ready() (uart_carrier_raised()->
+	 * get_mctrl()) block forever on open() when CLOCAL isn't already
+	 * active, hanging any respawn/getty tty open indefinitely. Treat
+	 * carrier/DSR/CTS as always present, as is standard practice for
+	 * UARTs without real modem-control wiring.
+	 */
+	result |= TIOCM_CAR | TIOCM_DSR | TIOCM_CTS;
 	return result;
 }
 
@@ -1544,6 +1555,10 @@ static int pl011_hwinit(struct uart_port *port)
 		return retval;
 
 	uap->port.uartclk = clk_get_rate(uap->clk);
+	/* No resolvable clk (see pl011_probe) -- fall back to a sane
+	 * default so baud-rate divisor math doesn't divide by zero. */
+	if (!uap->port.uartclk)
+		uap->port.uartclk = 24000000;
 
 	/* Clear pending error and receive interrupts */
 	writew(UART011_OEIS | UART011_BEIS | UART011_PEIS | UART011_FEIS |
@@ -2175,6 +2190,10 @@ static int __init pl011_console_setup(struct console *co, char *options)
 	}
 
 	uap->port.uartclk = clk_get_rate(uap->clk);
+	/* No resolvable clk (see pl011_probe) -- fall back to a sane
+	 * default so baud-rate divisor math doesn't divide by zero. */
+	if (!uap->port.uartclk)
+		uap->port.uartclk = 24000000;
 
 	if (uap->vendor->fixed_options) {
 		baud = uap->fixed_baud;
@@ -2368,8 +2387,23 @@ static int pl011_probe(struct amba_device *dev, const struct amba_id *id)
 		return -ENOMEM;
 
 	uap->clk = devm_clk_get(&dev->dev, NULL);
-	if (IS_ERR(uap->clk))
-		return PTR_ERR(uap->clk);
+	if (IS_ERR(uap->clk)) {
+		/*
+		 * Some platforms (e.g. QEMU's "virt" board) describe this
+		 * UART's clock via a DT "fixed-clock" phandle that this
+		 * particular kernel's active clock provider (COMMON_CLK_MSM,
+		 * built without the generic common clock framework core)
+		 * can never resolve -- clk_get() then either defers forever
+		 * or fails outright. The rest of this driver's clk_prepare/
+		 * clk_enable/clk_get_rate call sites already tolerate a NULL
+		 * struct clk (see drivers/clk/msm/clock.c), so degrade
+		 * gracefully instead of failing probe entirely.
+		 */
+		dev_warn(&dev->dev,
+			 "no usable clock (%ld), continuing without one\n",
+			 PTR_ERR(uap->clk));
+		uap->clk = NULL;
+	}
 
 	uap->vendor = vendor;
 	uap->lcrh_rx = vendor->lcrh_rx;
